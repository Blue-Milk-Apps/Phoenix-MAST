{% macro functionality_icon(name, present) %}
{% set icon = name | lower | replace('_', ' ') | replace('-', ' ') %}
{% set tint = '#16233c' if present else '#b6bec9' %}
<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" color="{{ tint }}" stroke="{{ tint }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if icon == 'audio' %}
<path d="M9 18V5l12-2v13" />
  <circle cx="6" cy="18" r="3" />
  <circle cx="18" cy="16" r="3" />
  {% elif icon in ['biometric authentication', 'fingerprint'] %}
<path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4" />
  <path d="M14 13.12c0 2.38 0 6.38-1 8.88" />
  <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02" />
