<div class="section">
  <h2>Application Functionality</h2>
  <p class="func-legend"><span class="func-legend-present">Detected</span><span class="func-legend-absent">Not detected</span></p>
  <div class="func-grid" role="list">
    {% for name, f in data.functionality.items() %}
    {% set present = f.present is sameas true or f.status == 'present' %}
    {% set status = f.status or ('present' if present else 'not_evaluated' if f.present is none else 'not_present') %}
    <div class="func-item {{ 'func-present' if present else 'func-absent' }}" role="listitem" title="{{ f.explanation | e }}" aria-label="{{ name | e }}: {{ status | replace('_', ' ') | e }}">
      {{ functionality_icon(name, present) }}
      <div class="func-name">{{ name | e }}</div>
      {% if status not in ['present', 'not_present'] %}
      <div class="func-status">{{ status | replace('_', ' ') | capitalize | e }}</div>
      {% endif %}
    </div>
    {% else %}
    <p class="small">Functionality was not evaluated for this scan.</p>
    {% endfor %}
  </div>
</div>

<!-- ===================== VULNERABILITY SECTIONS ===================== -->
{% for section in data.vulnerability_sections %}
<div class="section checks-section">
  <h2>{{ section.section_name | e }}</h2>
  {% if section.findings_text %}
  <h3>Findings</h3>
  <div class="vuln-findings">{{ section.findings_text }}</div>
  {% endif %}
  {% if section.checks %}
  <table class="findings-table">
    <thead>
    <tr>
      <th class="col-check">Check</th>
      <th class="col-severity">Severity</th>
      <th class="col-finding-type">Finding Type</th>
      <th class="col-explain">Explanation</th>
      <th class="col-compliance">Compliance</th>
      <th class="col-evidence">Evidence</th>
    </tr>
    </thead>
    <tbody>
    {% for c in section.checks %}
    <tr>
      <td>{{ c.check | e }}</td>
      <td>{{ risk_badge(c.severity) }}</td>
      <td>{{ (c.finding_type or ('control' if c.severity == 'Secure' else 'review' if c.severity == 'Hotspot' else 'weakness')) | title | e }}</td>
      <td>
        {{ c.explanation | e }}
        {% if c.platform_assessments | length > 1 %}
        <div class="small">
          {% for assessment in c.platform_assessments %}
          {{ assessment.platform|replace('_', ' ')|title }}: {{ assessment.status }}{% if not loop.last %}; {% endif %}
          {% endfor %}
        </div>
        {% endif %}
        {% if c.remediation_link %}<br><span class="small">Remediation: {{ c.remediation_link | e }}</span>{% endif %}{% if c.confidence_caveat and show_confidence_caveats %}<br><span class="small confidence-caveat">⚠ {{ c.confidence_caveat | e }}</span>{% endif %}
      </td>
      <td class="small finding-compliance">{{ c.compliance | e }}</td>
      <td class="small rule-evidence">{{ c.evidence | e }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endfor %}

<!-- ===================== HARDCODED VALUES ===================== -->
{% if presentation.target_type == 'binary' %}
<div class="section">
  <h2>Hard-Coded Values Found</h2>
  <h3>URLs</h3>
  {% if data.hardcoded_values.urls %}
  <table class="compact">
    <tr><th>URL</th><th>Country</th></tr>
    {% for u in data.hardcoded_values.urls %}
    <tr><td class="mono">{{ u.url }}</td><td>{{ u.country }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="small">No hardcoded URL strings were found.</p>
  {% endif %}

  <h3>Emails</h3>
  {% if data.hardcoded_values.emails %}
  <table class="compact">
    <tr><th>Email</th></tr>
    {% for e in data.hardcoded_values.emails %}
    <tr><td class="mono">{{ e }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="small">No hard-coded email addresses were found.</p>
  {% endif %}

</div>
{% endif %}

<!-- ===================== SECRET SCANNERS ===================== -->
<div class="section">
  {% if presentation.show_url_schemes %}
  <div class="url-schemes">
    <h2>{{ 'Custom URI Schemes' if data.meta.platform == 'Android' else 'Custom URL Schemes' }}</h2>
    {% if data.url_schemes %}
    <table class="compact">
      <thead><tr><th>{{ 'Component' if data.meta.platform == 'Android' else 'URL Name' }}</th><th>Schemes</th></tr></thead>
      <tbody>
      {% for u in data.url_schemes %}
      <tr><td class="mono">{{ u.url_name | e }}</td><td class="mono">{{ u.schemes | join(', ') | e }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="small">No custom {{ 'URI' if data.meta.platform == 'Android' else 'URL' }} schemes were declared by this app.</p>
    {% endif %}
  </div>
  {% endif %}
  <h2>Hardcoded Secrets</h2>
  {% if data.secret_scans %}
  <p class="small">Findings are counted separately for each scanner and may overlap.</p>
  <table>
    <thead><tr><th>Scanner</th><th>Status</th><th>Findings</th><th>Verified</th></tr></thead>
    <tbody>
    {% for scan in data.secret_scans %}
    <tr>
      <td>{{ scan.scanner | e }}</td>
      <td>{{ scan.status | e }}{% if scan.reason %}<div class="small">{{ scan.reason | e }}</div>{% endif %}</td>
      <td>{{ scan.findings | length if scan.status in ['Completed', 'Partial'] else 'Unknown' }}</td>
      <td>{{ scan.findings | selectattr('verification', 'equalto', 'Verified') | list | length if scan.scanner == 'TruffleHog' and scan.status in ['Completed', 'Partial'] else 'Not assessed' }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% for scan in data.secret_scans if scan.findings %}
  <h3>{{ scan.scanner | e }} Findings</h3>
  <table class="secret-findings">
    <thead><tr><th>Detector</th><th>Location</th><th>Verification</th></tr></thead>
    <tbody>
    {% for finding in scan.findings %}
    <tr><td>{{ finding.detector | e }}</td><td>{{ finding.location | e }}</td><td>{{ finding.verification | e }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endfor %}
  {% else %}
  <p class="small">Secret-scanner results were not included in this saved report.</p>
  {% endif %}
</div>

<!-- ===================== ENDPOINTS ===================== -->
<div class="section">
  <h2>Endpoint Connections</h2>
  <p class="small">The following network destinations were identified in the available analysis evidence.</p>
  {% set detailed_endpoints = data.meta.platform == "React Native" %}
  <table class="compact">
    <tr>
      <th>Endpoint</th><th>Tags</th>
      {% if detailed_endpoints %}<th>Source</th><th>Connection</th><th>Security</th>{% endif %}
      <th>IP Address</th><th>Country</th>
    </tr>
    {% for e in data.endpoints %}
    <tr>
      <td class="mono">{{ e.endpoint }}</td><td>{{ e.tags }}</td>
      {% if detailed_endpoints %}
      <td class="mono">{{ e.source }}</td><td>{{ e.connection_type }}</td><td>{{ e.transport_security }}</td>
      {% endif %}
      <td class="mono">{{ e.ip_address }}</td><td>{{ e.country }}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="small">* If country code is not provided it could not be determined.</p>
</div>

</body>
</html>
