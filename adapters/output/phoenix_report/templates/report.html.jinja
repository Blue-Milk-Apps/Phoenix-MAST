<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>{{ css }}</style>
</head>
<body>
{% set presentation = presentation | default(data.presentation) %}
{% set is_ios_report = data.meta.platform == 'iOS' %}
{% set is_native_ios_source = presentation.target_type == 'source' and data.meta.platform == 'iOS' %}

<!-- ===================== COVER ===================== -->
<div class="cover">
  <div class="cover-topbar">
    <div class="report-brand-card">
      <img class="report-brand-icon" src="{{ phoenix_brand_icon_uri }}" alt="">
      <div class="report-brand-copy">
        <div class="report-brand-name">phoenix</div>
        <div class="report-brand-tag">Mobile Security Report</div>
      </div>
    </div>
  </div>
  <div class="cover-heading">
    <img class="cover-icon" src="{{ app_icon_uri }}" alt="{{ data.meta.app_display_name | e }} app icon">
    <div class="cover-heading-text">
      <div class="title">{{ data.meta.app_display_name }}</div>
      <div class="subtitle">{{ presentation.assessment_title }}</div>
    </div>
  </div>
  <div class="cover-details">
  <table class="meta-table">
    {% if presentation.target_type != 'source' %}
    <tr><td class="label">{{ presentation.target_label }}</td><td class="value">{{ data.meta.file_name }}</td></tr>
    {% endif %}
    {% set package_name = data.native_ios_details.bundle_identifier if is_native_ios_source else data.meta.package_name %}
    {% if package_name %}
    <tr><td class="label">{{ 'Bundle Identifier' if is_ios_report else 'Package Name' }}</td><td class="value">{{ package_name | e }}</td></tr>
    {% endif %}
    {% if data.meta.version_name or data.meta.version_code %}
    <tr><td class="label">Version</td><td class="value">{% if data.meta.version_name and data.meta.version_code %}{{ data.meta.version_name }} ({{ data.meta.version_code }}){% else %}{{ data.meta.version_name or data.meta.version_code }}{% endif %}</td></tr>
    {% endif %}
    {% if data.meta.platform == 'Android' %}
    {% set android_info = data.native_android_details if presentation.target_type == 'source' else data.app_info %}
    {% if android_info.main_activity %}<tr><td class="label">Main Activity</td><td class="value">{{ android_info.main_activity | e }}</td></tr>{% endif %}
    {% if android_info.target_sdk %}<tr><td class="label">Target SDK</td><td class="value">{{ android_info.target_sdk | e }}</td></tr>{% endif %}
    {% if android_info.min_sdk %}<tr><td class="label">Min SDK</td><td class="value">{{ android_info.min_sdk | e }}</td></tr>{% endif %}
    {% if android_info.max_sdk %}<tr><td class="label">Max SDK</td><td class="value">{{ android_info.max_sdk | e }}</td></tr>{% endif %}
    {% elif is_native_ios_source and data.native_ios_details.minimum_os %}
    <tr><td class="label">Minimum OS</td><td class="value">{{ data.native_ios_details.minimum_os | e }}</td></tr>
    {% endif %}
    {% if presentation.show_file_hashes and is_ios_report %}
    {% if data.app_info.main_activity %}<tr><td class="label">Main Executable</td><td class="value">{{ data.app_info.main_activity }}</td></tr>{% endif %}
    <tr><td class="label">Size</td><td class="value">{{ data.file_info.size }}</td></tr>
    <tr><td class="label">MD5</td><td class="value mono">{{ data.file_info.md5 }}</td></tr>
    <tr><td class="label">SHA-1</td><td class="value mono">{{ data.file_info.sha1 }}</td></tr>
    <tr><td class="label">SHA-256</td><td class="value mono">{{ data.file_info.sha256 }}</td></tr>
    {% endif %}
    <tr><td class="label">Scan Date</td><td class="value">{{ data.meta.scan_date }}</td></tr>
    <tr><td class="label">Platform</td><td class="value">{{ data.meta.platform }}</td></tr>
    {% if data.app_info.app_store_id %}
    <tr><td class="label">{{ 'App Store' if data.meta.platform == 'iOS' else 'Play Store' }}</td><td class="value">{{ data.app_info.app_store_id }}</td></tr>
    {% endif %}
    {% if data.app_info.developer %}
    <tr><td class="label">Developer</td><td class="value">{{ data.app_info.developer }}</td></tr>
    {% endif %}
    {% if data.app_info.categories %}
    <tr><td class="label">Categories</td><td class="value">{{ data.app_info.categories }}</td></tr>
    {% endif %}
    {% if data.app_info.trackers_detected %}
    <tr><td class="label">Trackers Detected</td><td class="value">{{ data.app_info.trackers_detected }}</td></tr>
    {% endif %}
  </table>
  </div>
</div>

<!-- ===================== OVERALL RISK ===================== -->
<div class="section">
  <h2>Overall Security</h2>
  <div class="security-overview no-break">
    <div class="severity-bars" aria-label="Finding counts by severity">
      {% set max_count = [data.findings_severity.values() | max, 1] | max %}
      {% for level, color, key in [('Critical','#8e1b1b','critical'), ('High','#c0392b','high'), ('Medium','#e08e0b','medium'), ('Low','#5499c7','low'), ('Info','#2980b9','info'), ('Secure','#27ae60','secure')] %}
      {% set count = data.findings_severity.get(key, 0) %}
      <div class="bar-block">
        <div class="bar-label-row">
          <span class="bar-label">{{ level }}</span>
          <span class="bar-count-chip" style="background:{{ color }};">{{ count }}</span>
        </div>
        <div class="bar-track"><div class="bar-fill" style="width:{{ (count / max_count * 100) | round(1) }}%; background:{{ color }};"></div></div>
      </div>
      {% endfor %}
    </div>
    {% if data.overall_evaluation %}
    <div class="risk-graph-wrap">
      <img class="polar-chart" src="data:image/png;base64,{{ charts.overall_risk_polar }}" alt="Overall security by area">
    </div>
    {% endif %}
  </div>

  <h2>Summary</h2>
  {% if data.overall_evaluation %}
  <table class="summary-table">
    <thead><tr><th class="col-area">Area</th><th class="col-summary-severity">Severity</th><th>Findings Summary</th></tr></thead>
    <tbody>
    {% for row in data.overall_evaluation %}
    <tr>
      <td>{{ row.area_of_concern }}</td>
      <td>{{ risk_badge(row.risk_rating) }}</td>
      <td class="eval-findings"><ul>{% for f in row.summary_findings %}<li>{{ f }}</li>{% endfor %}</ul></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No matching findings were recorded. Review scan coverage for any incomplete or unavailable checks.</p>
  {% endif %}
</div>

<!-- ===================== CERTIFICATE / FILE / COMPONENTS ===================== -->
{% if not is_native_ios_source %}
<div class="section">
  {% if presentation.target_type != 'source' and data.meta.platform != 'iOS' %}
  <h2>Certificate Information</h2>
  <table class="kv-table">
    <tr><td class="k">Owner Name</td><td class="v">{{ data.certificate.owner_name }}</td></tr>
    <tr><td class="k">Organization</td><td class="v">{{ data.certificate.organization }}</td></tr>
    <tr><td class="k">Organizational Unit</td><td class="v">{{ data.certificate.organizational_unit }}</td></tr>
    <tr><td class="k">Location</td><td class="v">{{ data.certificate.location }}</td></tr>
    <tr><td class="k">Validity</td><td class="v">{{ data.certificate.validity }}</td></tr>
    <tr><td class="k">Issuer</td><td class="v">{{ data.certificate.issuer }}</td></tr>
    <tr><td class="k">Serial Number</td><td class="v mono">{{ data.certificate.serial_number }}</td></tr>
    <tr><td class="k">Signature Versions</td><td class="v">
      v1: {{ "Yes" if data.certificate.signature_versions.v1 else "No" }} &nbsp;|&nbsp;
      v2: {{ "Yes" if data.certificate.signature_versions.v2 else "No" }} &nbsp;|&nbsp;
      v3: {{ "Yes" if data.certificate.signature_versions.v3 else "No" }} &nbsp;|&nbsp;
      v4: {{ "Yes" if data.certificate.signature_versions.v4 else "No" }}
    </td></tr>
    <tr><td class="k">Hash Algorithms</td><td class="v">{{ data.certificate.hash_algorithms }}</td></tr>
    <tr><td class="k">Fingerprint</td><td class="v mono">{{ data.certificate.fingerprint }}</td></tr>
    <tr><td class="k">Unique Certs</td><td class="v">{{ data.certificate.unique_certs }}</td></tr>
  </table>
  {% endif %}

  {% if presentation.show_file_hashes and not is_ios_report %}
    <h2>{{ presentation.target_information_heading }}</h2>
    <table class="kv-table">
      <tr><td class="k">{{ presentation.target_label }}</td><td class="v">{{ data.file_info.filename }}</td></tr>
      {% if presentation.show_file_hashes %}
      <tr><td class="k">Size</td><td class="v">{{ data.file_info.size }}</td></tr>
      <tr><td class="k">MD5</td><td class="v mono">{{ data.file_info.md5 }}</td></tr>
      <tr><td class="k">SHA-1</td><td class="v mono">{{ data.file_info.sha1 }}</td></tr>
      <tr><td class="k">SHA-256</td><td class="v mono">{{ data.file_info.sha256 }}</td></tr>
      {% endif %}
    </table>

  {% endif %}

  {% if presentation.show_ios_binary_analysis %}
  <h2>Binary Security Protections</h2>
  <table>
    <tr><th class="col-check">Protection</th><th class="col-result">Status</th><th class="col-severity">Severity</th><th>Description</th></tr>
    {% for p in data.ipa_binary_protections %}
    <tr>
      <td>{{ p.protection }}</td>
      <td><span class="badge badge-{{ p.severity | lower }}">{{ p.status }}</span></td>
      <td><span class="badge badge-{{ p.severity | lower }}">{{ p.severity }}</span></td>
      <td>{{ p.description }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if data.meta.platform == 'iOS' and presentation.target_type == 'BINARY' and data.ios_binary_manual_review_available %}
  <h2>Requires Manual Review</h2>
  <p class="small">These checks need source-level or runtime validation and are not confirmed findings from binary evidence alone.</p>
  <p class="small">Assessment status: {{ data.ios_binary_manual_review_status }}</p>
  <table>
    <tr><th>Rule</th><th>Scope</th><th>Severity</th><th>Location</th><th>Reason</th><th>Finding</th></tr>
    {% for finding in data.ios_binary_manual_review_findings %}
    <tr><td class="mono">{{ finding.rule_id }}</td><td>{{ finding.scope }}</td><td>{{ finding.severity }}</td><td class="mono">{{ finding.location }}</td><td>{{ finding.reason }}</td><td>{{ finding.message }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if data.meta.platform != 'iOS' and (data.meta.platform != 'Flutter' or data.app_components.activities is not none or data.app_components.services is not none or data.app_components.receivers is not none or data.app_components.providers is not none) %}
  <h2>App Components</h2>
  <div class="components-bars">
    {% set component_rows = [
      ('Activities', data.app_components.activities or 0, data.app_components.exported_activities or 0),
      ('Services', data.app_components.services or 0, data.app_components.exported_services or 0),
      ('Receivers', data.app_components.receivers or 0, data.app_components.exported_receivers or 0),
      ('Providers', data.app_components.providers or 0, data.app_components.exported_providers or 0)
    ] %}
    {% set max_total = (component_rows | map(attribute=1) | list | max) or 1 %}
    {% for label, total, exported in component_rows %}
    {% set width_pct = (total / max_total * 100) if max_total else 0 %}
    {% set exported_pct = (exported / total * 100) if total else 0 %}
    <div class="component-bar-row">
      <div class="component-bar-label-row">
        <span class="component-bar-label">{{ label }}</span>
        <span class="component-bar-count">{{ total }} total &middot; <span class="component-bar-exported">{{ exported }} exported</span></span>
      </div>
      <div class="component-bar-track" style="width: {{ width_pct | round(1) }}%;">
        <div class="component-bar-exported-fill" style="width: {{ exported_pct | round(1) }}%;"></div>
        <div class="component-bar-safe-fill" style="width: {{ (100 - exported_pct) | round(1) }}%;"></div>
      </div>
    </div>
    {% endfor %}
    <div class="component-bar-legend">
      <span class="legend-swatch legend-exported"></span> Exported
      <span class="legend-swatch legend-safe"></span> Not Exported
    </div>
  </div>
  {% endif %}
</div>
{% endif %}

{% if data.meta.platform == 'Flutter' %}
<!-- ===================== FLUTTER PROJECT INVENTORY ===================== -->
<div class="section">
  <h2>Flutter Project Inventory</h2>
  <table class="kv-table">
    <tr><td class="k">Metadata Extraction</td><td class="v">{{ data.flutter_presentation.extraction_status }}</td></tr>
    <tr><td class="k">Dart SDK Constraint</td><td class="v mono">{{ data.flutter_presentation.dart_sdk_constraint or 'Not declared' }}</td></tr>
    <tr><td class="k">Flutter SDK Constraint</td><td class="v mono">{{ data.flutter_presentation.flutter_sdk_constraint or 'Not declared' }}</td></tr>
    <tr><td class="k">Android Application ID</td><td class="v mono">{{ data.flutter_presentation.android_application_id or 'Not available' }}</td></tr>
    <tr><td class="k">iOS Bundle Identifier</td><td class="v mono">{{ data.flutter_presentation.ios_bundle_identifier or 'Not available' }}</td></tr>
    {% if data.flutter_presentation.description %}<tr><td class="k">Description</td><td class="v">{{ data.flutter_presentation.description }}</td></tr>{% endif %}
    {% if data.flutter_presentation.homepage %}<tr><td class="k">Homepage</td><td class="v mono">{{ data.flutter_presentation.homepage }}</td></tr>{% endif %}
    {% if data.flutter_presentation.repository %}<tr><td class="k">Repository</td><td class="v mono">{{ data.flutter_presentation.repository }}</td></tr>{% endif %}
  </table>

  {% if data.flutter_presentation.warnings %}
  <h3>Extraction Warnings</h3>
  <ul>{% for warning in data.flutter_presentation.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
  {% endif %}

  <h3>Generated Platforms</h3>
  <table class="compact">
    <tr><th>Platform</th><th>Detected</th><th>Metadata</th><th>Identifier</th><th>Version</th><th>Requirements</th></tr>
    {% for platform in data.flutter_presentation.platforms %}
    <tr>
      <td>{{ platform.name }}</td>
      <td>{{ 'Yes' if platform.detected else 'No' }}</td>
      <td>{{ platform.metadata_status }}</td>
      <td class="mono">{{ platform.identifier }}</td>
      <td>{{ platform.version }}</td>
      <td>{{ platform.requirements }}</td>
    </tr>
    {% endfor %}
  </table>

</div>

<!-- ===================== FLUTTER DEPENDENCIES ===================== -->
<div class="section">
  <h2>Flutter Dependency Inventory</h2>
  <p class="small">Declared metadata: {{ data.flutter_presentation.dependencies.metadata_status }} &middot; SBOM: {{ data.flutter_presentation.dependencies.sbom_status }}</p>

  <h3>Declared Dependencies</h3>
  {% if data.flutter_presentation.dependencies.declared %}
  <table class="compact">
    <tr><th>Name</th><th>Constraint</th><th>Scope</th><th>Source</th></tr>
    {% for dependency in data.flutter_presentation.dependencies.declared %}
    <tr><td class="mono">{{ dependency.name }}</td><td class="mono">{{ dependency.constraint }}</td><td>{{ dependency.scope }}</td><td>{{ dependency.source }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p class="small">No declared dependency records were available.</p>{% endif %}

  <h3>Resolved Dependencies</h3>
  {% if data.flutter_presentation.dependencies.resolved %}
  <table class="compact">
    <tr><th>Name</th><th>Version</th><th>Kind</th><th>Source</th></tr>
    {% for dependency in data.flutter_presentation.dependencies.resolved %}
    <tr><td class="mono">{{ dependency.name }}</td><td class="mono">{{ dependency.version }}</td><td>{{ dependency.dependency_kind }}</td><td>{{ dependency.source }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p class="small">No resolved dependency records were available.</p>{% endif %}

  <h3>SBOM Packages</h3>
  {% if data.flutter_presentation.dependencies.sbom_packages %}
  <table class="compact">
    <tr><th>Name</th><th>Version</th><th>Artifact</th></tr>
    {% for package in data.flutter_presentation.dependencies.sbom_packages %}
    <tr><td class="mono">{{ package.name }}</td><td class="mono">{{ package.version }}</td><td class="mono">{{ package.output_path }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p class="small">No SBOM package records were available.</p>{% endif %}
</div>

<!-- ===================== FLUTTER LINKS ===================== -->
<div class="section">
  <h2>Application Links and URL Schemes</h2>
  <h3>Android Deep Links</h3>
  {% if data.flutter_presentation.deep_links %}
  <table class="compact">
    <tr><th>URI Pattern</th><th>Component</th><th>MIME Type</th></tr>
    {% for link in data.flutter_presentation.deep_links %}
    <tr><td class="mono">{{ link.uri }}</td><td class="mono">{{ link.component }}</td><td>{{ link.mime_type }}</td></tr>
    {% endfor %}
  </table>
  {% elif data.flutter_presentation.deep_links_assessed %}<p class="small">No Android deep links were declared.</p>
  {% else %}<p class="small">Android deep links were not assessed.</p>{% endif %}

  <h3>iOS URL Schemes</h3>
  {% if data.flutter_presentation.url_schemes %}
  <table class="compact">
    <tr><th>Application</th><th>Declared Schemes</th></tr>
    {% for item in data.flutter_presentation.url_schemes %}
    <tr><td>{{ item.url_name }}</td><td class="mono">{{ item.schemes | join(', ') }}</td></tr>
    {% endfor %}
  </table>
  {% elif data.flutter_presentation.url_schemes_assessed %}<p class="small">No iOS URL schemes were declared.</p>
  {% else %}<p class="small">iOS URL schemes were not assessed.</p>{% endif %}

  <h3>Queried iOS Schemes</h3>
  {% if data.flutter_presentation.queried_url_schemes %}<p class="mono">{{ data.flutter_presentation.queried_url_schemes | join(', ') }}</p>
  {% elif data.flutter_presentation.url_schemes_assessed %}<p class="small">No queried iOS schemes were declared.</p>
  {% else %}<p class="small">Queried iOS schemes were not assessed.</p>{% endif %}
</div>

{% if data.flutter_presentation.manual_review_available %}
<!-- ===================== FLUTTER MANUAL REVIEW ===================== -->
<div class="section">
  <h2>Requires Manual Review</h2>
  <p class="small">Potential security concerns that require human validation before they can be classified as confirmed findings.</p>
  <p class="small">Assessment status: {{ data.flutter_presentation.manual_review_status }}</p>
  {% if data.flutter_presentation.manual_review_findings %}
  <table>
    <tr><th>Rule</th><th>Scope</th><th>Severity</th><th>Location</th><th>Reason</th><th>Finding</th></tr>
    {% for finding in data.flutter_presentation.manual_review_findings %}
    <tr><td class="mono">{{ finding.rule_id }}</td><td>{{ finding.scope }}</td><td>{{ finding.severity }}</td><td class="mono">{{ finding.location }}</td><td>{{ finding.reason }}</td><td>{{ finding.message }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p class="small">The assessed rules did not identify any potential security concerns requiring manual review.</p>{% endif %}
</div>
{% endif %}
{% endif %}

{% if data.meta.platform == 'iOS' and presentation.target_type == 'source' and data.native_ios_details.manual_review_available %}
<!-- ===================== NATIVE IOS MANUAL REVIEW ===================== -->
<div class="section">
  <h2>Requires Manual Review</h2>
  <p class="small">Potential security concerns that require human validation before they can be classified as confirmed findings.</p>
  <p class="small">Assessment status: {{ data.native_ios_details.manual_review_status }}</p>
  {% if data.native_ios_details.manual_review_findings %}
  <table>
    <tr><th>Rule</th><th>Scope</th><th>Severity</th><th>Location</th><th>Reason</th><th>Finding</th></tr>
    {% for finding in data.native_ios_details.manual_review_findings %}
    <tr><td class="mono">{{ finding.rule_id }}</td><td>{{ finding.scope }}</td><td>{{ finding.severity }}</td><td class="mono">{{ finding.location }}</td><td>{{ finding.reason }}</td><td>{{ finding.message }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p class="small">The assessed rules did not identify any potential security concerns requiring manual review.</p>{% endif %}
</div>
{% endif %}

